# Copie para .env e ajuste.

# Conexão com o SQL Server.
# Autenticação do Windows (sem usuário/senha), SQL Express local:
#   sqlserver://localhost:PORTA?database=AgroStock&encrypt=disable
# (a porta do SQLEXPRESS costuma ser dinâmica; veja no SQL Server Configuration Manager)
# Autenticação SQL:
#   sqlserver://usuario:senha@localhost:1433?database=AgroStock&encrypt=disable
DATABASE_URL=sqlserver://localhost:1433?database=AgroStock&encrypt=disable

# Porta da API
API_ADDR=:8080

# Origens do frontend autorizadas a chamar a API com cookies (CORS).
# Várias origens: separe por vírgula (ex: http://localhost:5173,https://app.exemplo.com)
ALLOWED_ORIGIN=http://localhost:5173

# true em produção (HTTPS). Em localhost via http, deixe false.
# Com true, o cookie de sessão sai com Secure + SameSite=None, necessário quando
# o frontend está em outro domínio (ex: Vercel) e a API em outro (ex: Render).
# Com false, sai com SameSite=Lax (só funciona com front e API no mesmo site).
COOKIE_SECURE=false

# Duração da sessão (ex: 8h, 30m)
SESSION_TTL=8h

# Recuperação de senha: a API ainda não envia e-mail. Com true, o token de
# redefinição volta na resposta de POST /senha/esqueci e o frontend o mostra.
# SOMENTE EM DESENVOLVIMENTO — em produção deixe false (ou remova).
RESET_TOKEN_NA_RESPOSTA=false
